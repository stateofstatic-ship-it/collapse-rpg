; Engine configuration file for the collapse RPG device stress test.
config_version=5

[application]

config/name="Collapse RPG Device Test"
config/description="Week-one stress scene from design/chapters/tech.md. Placeholder art, real budgets."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/low_processor_mode=false

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="disabled"
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true
window/vsync/vsync_mode=1

[importer_defaults]

texture={
"compress/mode": 2,
"compress/high_quality": true,
"mipmaps/generate": false
}

[input_devices]

pointing/emulate_mouse_from_touch=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=1
